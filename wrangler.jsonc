{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bujafood-order",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bujafood-db",
      "database_id": "062e1d43-f5cd-48ec-a359-8fb73bf95374"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "bujafood-images"
    }
  ]
}
